SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production

# Production base URL (no trailing slash). Powers canonical tags, og:url,
# robots.txt and sitemap.xml. REQUIRED in production — set it on the host.
NUXT_PUBLIC_SITE_URL=https://example.com

# --- Contact form → Resend (server/api/contact.post.js) ---
# Server-only. Create a key at https://resend.com/api-keys (Sending access is
# enough). Without it the contact endpoint returns 503 and the form falls back
# to showing the mailto address.
NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to pedrosmborges@gmail.com — only set to override.
# NUXT_CONTACT_TO=pedrosmborges@gmail.com

# The From address. Resend only accepts a domain you have verified at
# https://resend.com/domains — until one is verified, leave this unset to use
# Resend's sandbox sender, which can ONLY deliver to the Resend account owner's
# own address. Set it once the site's domain is verified.
# NUXT_CONTACT_FROM=Portfolio <hello@yourdomain.com>
